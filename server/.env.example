# Neon Postgres connection string
# Format: postgresql://<user>:<password>@<host>/<dbname>?sslmode=require
DATABASE_URL=

PORT=5000
JWT_SECRET=change-this-to-a-long-random-string
NODE_ENV=development

# Comma-separated list of allowed origins for CORS (client dev URL by default)
CLIENT_ORIGIN=http://localhost:5173

# SMTP (Gmail example: use a Google App Password, not your normal Gmail password —
# requires 2FA enabled on the sending account)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Joshi's Commerce Academy
SMTP_FROM_EMAIL=

# Delay (ms) between individual emails in a batch send, to stay under Gmail's rate limits
MAIL_SEND_DELAY_MS=1500

# Cron schedule for the exam reminder job (default: daily at 08:00 server time)
REMINDER_CRON=0 8 * * *
