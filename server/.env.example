# Neon Postgres connection string
# Format: postgresql://<user>:<password>@<host>/<dbname>?sslmode=require
DATABASE_URL=

PORT=5000
JWT_SECRET=change-this-to-a-long-random-string
NODE_ENV=development

# Comma-separated list of allowed origins for CORS (client dev URL by default)
CLIENT_ORIGIN=http://localhost:5173

# Gmail API (OAuth 2.0) - use this instead of SMTP on Render Free
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://<your-render-service>.onrender.com/api/email/google/callback
GOOGLE_REFRESH_TOKEN=
GMAIL_USER=your-academy@gmail.com
EMAIL_FROM_NAME=Joshi's Commerce Academy

# Delay (ms) between individual emails in a batch send, to stay under Gmail's rate limits
MAIL_SEND_DELAY_MS=1500

# Cron schedule for the exam reminder job (default: daily at 08:00 server time)
REMINDER_CRON=0 8 * * *

# Minutes after an exam deadline that the server waits for a device that lost its connection to
# send its locally-kept answers, before finalising the attempt from what is already saved.
OFFLINE_SYNC_GRACE_MINUTES=120
